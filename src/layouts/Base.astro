---
import '../styles/global.css';
import { SITE, T, LANGS, type Lang } from '../data/site';
import { PAGES, colUrl, homeUrl, cName, cH1 } from '../lib/prompts';

interface Props {
  title: string;
  desc: string;
  lang?: Lang;
  /** For pages that exist in every language: the path after the language part.
      '' for the homepage, 'couple-photo-prompts/' for a collection. Leave out for English-only pages. */
  i18n?: string;
  schema?: object[];
  ogType?: string;
  noindex?: boolean;
  /** Share image (path or URL). Defaults to the site card. */
  image?: string;
}
const { title, desc, lang = 'en', i18n, schema = [], ogType = 'website', noindex = false, image } = Astro.props;
const t = T[lang];
const here = new URL(Astro.url.pathname, SITE.url).href;
const abs = (p: string) => new URL(p, SITE.url).href;
const home = homeUrl(lang);
// Where the language switcher sends you: the same page if it is translated, else that language's homepage.
const langUrl = (code: Lang) => (i18n === undefined ? homeUrl(code) : code === 'en' ? `/${i18n}` : `/${code}/${i18n}`);
const evergreen = PAGES.filter((c) => !c.festival);
// Categories = who or what the photo is of; Collections = themed looks.
const CAT_IDS = ['girls', 'boys', 'couple', 'family', 'wedding', 'genz', 'aesthetic', 'supercars', 'car-poses', 'collage', 'fix'];
const categories = CAT_IDS.map((id) => evergreen.find((c) => c.id === id)).filter((c): c is NonNullable<typeof c> => !!c);
const collectionsList = evergreen.filter((c) => !CAT_IDS.includes(c.id));
const festivals = PAGES.filter((c) => c.festival);
const orgSchema = {
  '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url,
  logo: `${SITE.url}/icon-512.png`,
};
const org = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url,
  inLanguage: `${lang}-IN`,
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={here} />
    {noindex && <meta name="robots" content="noindex" />}
    {i18n !== undefined && (
      <>
        {LANGS.map((l) => <link rel="alternate" hreflang={l.code} href={abs(langUrl(l.code))} />)}
        <link rel="alternate" hreflang="x-default" href={abs(langUrl('en'))} />
      </>
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={here} />
    <meta property="og:image" content={abs(image ?? '/og.png')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={abs(image ?? '/og.png')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:locale" content={`${lang}_IN`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />
    <script is:inline>
      // Apply the saved theme before the page paints, so there is no flash.
      try {
        var th = localStorage.getItem('theme');
        if (th !== 'light') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    </script>
    {[org, ...(Astro.url.pathname === '/' ? [orgSchema] : []), ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <style is:global>.site-footer h3 { color: var(--text); font-weight: 600; margin-bottom: 8px; font-size: 13px; }</style>
  </head>
  <body>
    <div class="topbar"><a href="/app/">📱 Android app coming soon</a></div>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={home}>PhotoEditing<span>Prompt</span></a>
        <form class="hsearch" action={home} method="get" role="search">
          <span class="hs-icon" aria-hidden="true">🔍</span>
          <input type="search" name="q" placeholder={t.search} aria-label={t.search} data-search autocomplete="off" />
          <button type="submit">{t.searchBtn}</button>
        </form>
        <nav class="nav" aria-label="Main">
          <a href="/trending/">{t.trending}</a>
          <details class="dd">
            <summary>{t.categories} ▾</summary>
            <div class="mnav-panel dd-panel">
              {categories.map((c) => <a href={colUrl(c, lang)}>{c.emoji} {cName(c, lang)}</a>)}
            </div>
          </details>
          <details class="dd">
            <summary>{t.collections} ▾</summary>
            <div class="mnav-panel dd-panel">
              {collectionsList.map((c) => <a href={colUrl(c, lang)}>{c.emoji} {cName(c, lang)}</a>)}
            </div>
          </details>
          <a href="/festivals/">{t.festivals}</a>
          <a href="/saved/">♡ Saved</a>
          <a href="/app/">📱 App</a>
        </nav>
        <details class="mnav">
          <summary aria-label="Menu">☰</summary>
          <div class="mnav-panel">
            <a href="/trending/">{t.trending}</a>
            <p class="mnav-h">{t.categories}</p>
            {categories.map((c) => <a href={colUrl(c, lang)}>{cName(c, lang)}</a>)}
            <p class="mnav-h">{t.collections}</p>
            {collectionsList.map((c) => <a href={colUrl(c, lang)}>{cName(c, lang)}</a>)}
            <a href="/festivals/">{t.festivals}</a>
            <a href="/saved/">♡ Saved</a>
            <a href="/app/">📱 App</a>
            <div class="pill-toggle" role="group" aria-label="Theme">
              <button type="button" data-theme-set="light" aria-pressed="true" aria-label="Light theme">☀</button>
              <button type="button" data-theme-set="dark" aria-pressed="false" aria-label="Dark theme">☾</button>
            </div>
          </div>
        </details>
        <div class="toggles">
          <label class="lang-select">
            <span class="sr-only">{t.language}</span>
            <select data-lang-switch aria-label={t.language}>
              {LANGS.map((l) => <option value={langUrl(l.code)} selected={l.code === lang} lang={l.code}>{l.native}</option>)}
            </select>
          </label>
          <div class="pill-toggle" role="group" aria-label="Theme">
            <button type="button" data-theme-set="light" aria-pressed="true" aria-label="Light theme">☀</button>
            <button type="button" data-theme-set="dark" aria-pressed="false" aria-label="Dark theme">☾</button>
          </div>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <h3>{t.collections}</h3>
            {[...categories, ...collectionsList].map((c) => <a href={colUrl(c, lang)}>{cH1(c, lang)}</a>)}
          </div>
          <div>
            <h3>{t.festivals}</h3>
            {festivals.map((c) => <a href={colUrl(c, lang)}>{cH1(c, lang)}</a>)}
            <a href="/festivals/">{t.all}</a>
          </div>
          <div>
            <h3>{SITE.name}</h3>
            <a href={home}>{t.home}</a>
            <a href="/trending/">{t.trending}</a>
            <a href="/about/">{t.about}</a>
            <a href="/contact/">{t.contact}</a>
            <a href="/app/">Android app – coming soon</a>
          </div>
          <div>
            <h3>Legal</h3>
            <a href="/privacy-policy/">{t.privacy}</a>
            <a href="/terms/">{t.terms}</a>
            <a href="/disclaimer/">Disclaimer</a>
            <a href="/copyright/">Copyright &amp; Takedown</a>
          </div>
        </div>
        <nav class="langs" aria-label={t.language}>
          {LANGS.map((l) => <a href={langUrl(l.code)} lang={l.code} hreflang={l.code}>{l.native}</a>)}
        </nav>
        <p class="legal">© {new Date().getFullYear()} {SITE.name}. {t.footNote}</p>
      </div>
    </footer>

    <script is:inline define:vars={{ copyLabel: t.copy, copiedLabel: t.copied }}>
      // ---- Theme toggle ----
      (function () {
        var root = document.documentElement;
        function sync() {
          var dark = root.getAttribute('data-theme') === 'dark';
          document.querySelectorAll('[data-theme-set]').forEach(function (b) {
            b.setAttribute('aria-pressed', String((b.dataset.themeSet === 'dark') === dark));
          });
        }
        document.querySelectorAll('[data-theme-set]').forEach(function (b) {
          b.addEventListener('click', function () {
            if (b.dataset.themeSet === 'dark') root.setAttribute('data-theme', 'dark');
            else root.removeAttribute('data-theme');
            try { localStorage.setItem('theme', b.dataset.themeSet); } catch (e) {}
            sync();
          });
        });
        sync();
      })();

      // ---- Language switcher ----
      (function () {
        var sel = document.querySelector('[data-lang-switch]');
        if (sel) sel.addEventListener('change', function () { window.location.href = sel.value; });
      })();

      // ---- Prompt customiser: rebuild the text when a dropdown changes ----
      function buildPrompt(block) {
        var tpl = block.dataset.template;
        var out = block.querySelector('[data-prompt-text]');
        var plain = '';
        out.textContent = '';
        tpl.split(/(\{\w+\})/).forEach(function (part) {
          var m = part.match(/^\{(\w+)\}$/);
          if (m) {
            var sel = block.querySelector('select[data-key="' + m[1] + '"]');
            var val = sel ? sel.value : part;
            var mark = document.createElement('mark');
            mark.textContent = val;
            out.appendChild(mark);
            plain += val;
          } else {
            // Block labels (IDENTITY LOCK:, AVOID: ...) are shown in bold.
            part.split(/((?:^|\n)[A-Z][A-Z ,]+:)/).forEach(function (seg) {
              if (/^\n?[A-Z][A-Z ,]+:$/.test(seg)) {
                var st = document.createElement('strong');
                st.className = 'blk';
                st.textContent = seg;
                out.appendChild(st);
              } else if (seg) out.appendChild(document.createTextNode(seg));
            });
            plain += part;
          }
        });
        block.dataset.current = plain;
      }
      document.querySelectorAll('[data-template]').forEach(function (block) {
        block.querySelectorAll('select[data-key]').forEach(function (s) {
          s.addEventListener('change', function () { buildPrompt(block); });
        });
        buildPrompt(block);
      });

      // ---- Full prompt toggle label ----
      document.querySelectorAll('details.full-prompt').forEach(function (d) {
        var lbl = d.querySelector('.lbl');
        d.addEventListener('toggle', function () { lbl.textContent = d.open ? d.dataset.hide : d.dataset.show; });
      });

      // ---- Copy buttons ----
      function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
        return new Promise(function (resolve, reject) {
          var ta = document.createElement('textarea');
          ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy') ? resolve() : reject(); } catch (e) { reject(e); }
          document.body.removeChild(ta);
        });
      }
      // Card prompts are fetched once, on the first Copy tap, so the page itself stays small.
      var textsPromise = null;
      function promptText(slug) {
        if (!textsPromise) textsPromise = fetch('/prompt-text.json').then(function (r) { return r.json(); });
        return textsPromise.then(function (all) { return all[slug] || ''; });
      }
      document.querySelectorAll('[data-copy-btn]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var block = btn.closest('[data-template]');
          var card = btn.closest('[data-slug]');
          var getText = block ? Promise.resolve(block.dataset.current) : promptText(card && card.dataset.slug);
          getText.then(function (text) { return copyText(text); }).then(function () {
            btn.textContent = '✓ ' + copiedLabel; btn.classList.add('done');
            setTimeout(function () { btn.textContent = copyLabel; btn.classList.remove('done'); }, 1800);
          }).catch(function () {});
        });
      });

      // ---- Open in ChatGPT / Gemini: copy the prompt, then open the app (or site) ----
      var toastEl = null;
      function toast(msg) {
        if (!toastEl) { toastEl = document.createElement('div'); toastEl.className = 'toast'; document.body.appendChild(toastEl); }
        toastEl.textContent = msg; toastEl.classList.add('show');
        setTimeout(function () { toastEl.classList.remove('show'); }, 3500);
      }
      document.querySelectorAll('[data-open]').forEach(function (a) {
        a.addEventListener('click', function () {
          var block = a.closest('[data-template]');
          var text = block ? block.dataset.current : '';
          if (!text) return;
          var which = a.dataset.open;
          // Do NOT cancel the tap or redirect from a timer: phones only hand the link to the
          // ChatGPT / Gemini app when the browser follows the tapped link itself.
          // ChatGPT on the web can take the prompt in the link; Gemini cannot, so the user pastes.
          if (which === 'chatgpt') a.href = 'https://chatgpt.com/?prompt=' + encodeURIComponent(text) + '&q=' + encodeURIComponent(text);
          copyText(text).catch(function () {});
          toast(which === 'chatgpt' ? 'Prompt copied. Upload your photo in ChatGPT.' : 'Prompt copied. Paste it in Gemini and upload your photo.');
        });
      });

      // ---- Before / after slider ----
      document.querySelectorAll('.ba input').forEach(function (r) {
        var box = r.parentElement, used = false;
        function set(v) { r.value = v; box.style.setProperty('--pos', v + '%'); }
        function stop() { used = true; box.classList.add('used'); }
        r.addEventListener('input', function () { stop(); set(r.value); });
        r.addEventListener('pointerdown', stop);
        // Auto-demo: when the slider scrolls into view, sweep it once so visitors see it moves.
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (e) {
              if (!e.isIntersecting) return;
              io.disconnect();
              var t0 = null, seq = [50, 15, 85, 50];
              function step(ts) {
                if (used) return;
                if (t0 === null) t0 = ts;
                var k = (ts - t0) / 900, i = Math.floor(k);
                if (i >= seq.length - 1) { set(50); return; }
                var f = k - i; f = f * f * (3 - 2 * f);
                set(seq[i] + (seq[i + 1] - seq[i]) * f);
                requestAnimationFrame(step);
              }
              setTimeout(function () { if (!used) requestAnimationFrame(step); }, 500);
            });
          }, { threshold: 0.6 });
          io.observe(box);
        }
      });

      // ---- Close open menus when clicking elsewhere ----
      document.addEventListener('click', function (ev) {
        document.querySelectorAll('details.dd[open], details.mnav[open]').forEach(function (d) {
          if (!d.contains(ev.target)) d.removeAttribute('open');
        });
      });

      // ---- Saved prompts (kept in this browser only) ----
      var favs = [];
      try { favs = JSON.parse(localStorage.getItem('favs') || '[]'); } catch (e) {}
      function syncFavs() {
        document.querySelectorAll('[data-fav]').forEach(function (b) {
          var on = favs.indexOf(b.dataset.fav) !== -1;
          b.setAttribute('aria-pressed', String(on));
          b.textContent = on ? '♥' : '♡';
        });
        var list = document.querySelector('[data-saved-list]');
        if (list) {
          var n = 0;
          list.querySelectorAll('[data-slug]').forEach(function (c) {
            var on = favs.indexOf(c.dataset.slug) !== -1;
            c.classList.toggle('hidden', !on); if (on) n++;
          });
          var em = document.querySelector('[data-saved-empty]');
          if (em) em.classList.toggle('hidden', n > 0);
        }
      }
      document.querySelectorAll('[data-fav]').forEach(function (b) {
        b.addEventListener('click', function () {
          var i = favs.indexOf(b.dataset.fav);
          if (i === -1) favs.push(b.dataset.fav); else favs.splice(i, 1);
          try { localStorage.setItem('favs', JSON.stringify(favs)); } catch (e) {}
          syncFavs();
        });
      });
      syncFavs();

      // ---- Search (header box): filters the cards on the homepage / trending; elsewhere it opens the homepage with ?q= ----
      (function () {
        var input = document.querySelector('[data-search]');
        if (!input) return;
        var cards = document.querySelectorAll('[data-card]');
        var empty = document.querySelector('[data-empty]');
        var chips = document.querySelectorAll('[data-chip]');
        var aud = 'all';
        chips.forEach(function (ch) {
          ch.addEventListener('click', function () {
            aud = ch.dataset.chip;
            chips.forEach(function (o) { o.setAttribute('aria-pressed', o === ch ? 'true' : 'false'); });
            run();
          });
        });
        function run() {
          var q = input.value.trim().toLowerCase();
          var shown = 0;
          cards.forEach(function (c) {
            var inAud = aud === 'all' || (' ' + c.dataset.aud + ' ').indexOf(' ' + aud + ' ') !== -1;
            // With a chip chosen, show every prompt that has a photo for that group; otherwise the first rows only.
            var base = q ? c.dataset.card.indexOf(q) !== -1 : (aud === 'all' ? c.dataset.extra !== '1' : c.dataset.img === '1');
            var hit = base && inAud;
            c.classList.toggle('hidden', !hit);
            if (hit) shown++;
          });
          if (empty) empty.classList.toggle('hidden', shown > 0);
          var title = document.querySelector('[data-gallery-title]');
          if (title) title.classList.toggle('hidden', !!q);
        }
        input.addEventListener('input', run);
        if (cards.length) {
          var form = input.form;
          if (form) form.addEventListener('submit', function (ev) {
            ev.preventDefault(); run();
            var g = document.getElementById('gallery'); if (g) g.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          try {
            var q0 = new URLSearchParams(window.location.search).get('q');
            if (q0) { input.value = q0; run(); }
          } catch (e) {}
        }
      })();
    </script>
  </body>
</html>
