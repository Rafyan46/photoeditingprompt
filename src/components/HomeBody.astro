---
import { T, type Lang } from '../data/site';
import { ALL, PAGES, colUrl, inCollection, cName } from '../lib/prompts';
import PromptCard from './PromptCard.astro';
import Steps from './Steps.astro';
import { thumbSize } from '../lib/thumb-size';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = T[lang];
import { HOME_FAQ } from '../data/site';
const CHUNK = 40; // the first 40 photos show at once; 'Load more' adds 40 at a time, and search finds every prompt
const NOT_ON_HOME = /^(mothers-day|fathers-day|friendship-day)-|underwater-wallpaper|rakhi-photo-collage|^stylish-|^guru-nanak-/;
const HOME = ALL.filter((p) => !NOT_ON_HOME.test(p.s));
const withImg = HOME.filter((p) => p.sample.chatgpt);
// The visible grid shows only prompts that have a real result image. Prompts without a photo yet are still in the page (hidden),
// so the search box can find them (for example "GTA 6" or "movie").
// Mix the collections so the first screen shows variety, with the ones people search for most (couple, viral, 80s) showing up most.
const WEIGHT: Record<string, number> = { couple: 3, viral: 2, eighties: 2, girls: 2, boys: 2 };
const groups = new Map<string, typeof withImg>();
for (const p of withImg) groups.set(p.c, [...(groups.get(p.c) ?? []), p]);
const order = [...groups.keys()].sort((a, b) => (WEIGHT[b] ?? 1) - (WEIGHT[a] ?? 1));
const mixed: typeof withImg = [];
for (let more = true; more;) {
  more = false;
  for (const id of order) {
    const g = groups.get(id)!;
    for (let k = 0; k < (WEIGHT[id] ?? 1) && g.length; k++) { mixed.push(g.shift()!); more = true; }
  }
}
const noImg = HOME.filter((p) => !p.sample.chatgpt);
// Trending strip: the viral looks, newest first, as one swipeable row above the gallery.
const trend = await Promise.all(withImg.filter((p) => p.c === 'viral').slice(0, 10).map(async (p) => ({ p, img: p.sample.chatgpt!.replace(/\.webp$/, '-thumb.webp'), size: await thumbSize(p.sample.chatgpt!.replace(/\.webp$/, '-thumb.webp')) })));
const chunks: (typeof ALL)[] = [];
for (let i = 0; i < mixed.length; i += CHUNK) chunks.push(mixed.slice(i, i + CHUNK));
if (noImg.length) chunks.push(noImg); // no photo yet: kept in the page for search only

// showcase: one before/after per collection, up to 8
const seen = new Set<string>();
const showcase = withImg.filter((p) => p.sample.before && !seen.has(p.c) && seen.add(p.c)).slice(0, 8);
const FALLBACK: Record<string, string> = { 'game-art': '/samples/game-art-tropical-night-criminal-duo-chatgpt.webp', couple: '/samples/col-couple.webp', family: '/samples/col-family.webp' };
// Round category buttons (Instagram-story style). Each one is a real link to its own page, which is what lets Google find and rank those pages.
const EN_LABEL: Record<string, string> = { 'game-art': 'GTA 6 Style', movies: 'Movie Stars', viral: 'Viral', supercars: 'Cars', family: 'Family' };
const ICONS = ['game-art', 'movies', 'viral', 'girls', 'boys', 'couple', 'family', 'supercars', 'christmas', 'new-year', 'pongal']
  .map((id) => PAGES.find((c) => c.id === id)).filter((c): c is NonNullable<typeof c> => !!c);
const NEWTAG = new Set(['game-art', 'movies']);
const th = (u?: string) => u?.replace(/\.webp$/, '-thumb.webp'); // small card-size copy made by scripts/make-thumbs.ts
const colImg = (id: string) => th(FALLBACK[id] ?? (inCollection(id).filter((p) => !NOT_ON_HOME.test(p.s)).find((p) => p.sample.chatgpt && !/collage|panel|bike|pump|motorbike|scooter|car|highway|poster/.test(p.s)) ?? inCollection(id).filter((p) => !NOT_ON_HOME.test(p.s)).find((p) => p.sample.chatgpt))?.sample.chatgpt);
---
<section class="hero wrap">
  <h1 set:html={t.heroTitle.replace(/(ChatGPT|Gemini)/g, '<span class="hl">$1</span>')} />
  <p class="lead">{t.heroLead}</p>
  <nav class="rings" aria-label={t.browse}>
    <a class="cring" href="#gallery">
      <span class="rg"><span class="disc all" aria-hidden="true">✨</span></span>
      <span class="rl">{t.all}</span>
    </a>
    {ICONS.map((c) => (
      <a class="cring" href={colUrl(c, lang)}>
        <span class="rg"><span class="disc" style={`background:${c.tint}`}>
          {colImg(c.id) ? <img src={colImg(c.id)} alt={`${cName(c, lang)} – AI photo editing result`} loading="lazy" width="64" height="64" /> : <span aria-hidden="true">{c.emoji}</span>}
        </span>{NEWTAG.has(c.id) && <i class="newtag">NEW</i>}</span>
        <span class="rl">{lang === 'en' && EN_LABEL[c.id] ? EN_LABEL[c.id] : cName(c, lang)}</span>
      </a>
    ))}
  </nav>
</section>

{lang === 'en' && trend.length > 0 && (
  <section class="wrap trend-strip" aria-label="Trending prompts">
    <div class="trend-head"><h2>🔥 Trending now</h2><a class="link" href="/trending/">See all trending ›</a></div>
    <div class="trend-row">
      {trend.map(({ p, img, size }) => (
        <a class="trend-item" href={p.url}>
          <img src={img} alt={`${p.t} – trending AI photo prompt result`} loading="lazy" decoding="async" width={size?.w ?? 400} height={size?.h ?? 500} />
          <span>{p.t}</span>
        </a>
      ))}
    </div>
  </section>
)}

<section class="wrap" id="gallery">
  <h2 class="sr-only" data-gallery-title>{t.newest}</h2>
  {t.promptsEnglish && <p class="muted" style="margin:0 0 14px;text-align:center">{t.promptsEnglish}</p>}
  {lang === 'en' && (
    <div class="chips wall-chips" role="group" aria-label="Filter prompts">
      {[['all', 'All'], ['boy', 'Boys'], ['girl', 'Girls'], ['couple', 'Couple'], ['family', 'Family'], ['car', 'Cars']].map(([k, l]) => (
        <button class="chip" type="button" data-chip={k} aria-pressed={k === 'all' ? 'true' : 'false'}>{l}</button>
      ))}
    </div>
  )}
  {lang === 'en' && <p class="muted wall-count">{ALL.length} free prompts · new ones added every few days</p>}
  {chunks.map((ch, ci) => (
    <div class="grid wall">
      {ch.map((p, i) => <PromptCard p={p} lang={lang} extra={ci > 0} chunk={ci} eager={ci === 0 && i < 4} showBefore />)}
    </div>
  ))}
  <p class="muted hidden" data-empty style="text-align:center;padding:40px 0">{t.noResults}</p>
  <p style="text-align:center;margin-top:28px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
    {chunks.length > 2 && <button class="btn" type="button" data-loadmore>Load more prompts</button>}
    <a class="btn ghost" href="/trending/">{t.all} {ALL.length} {t.prompts} ›</a>
    <a class="btn ghost" href="/festivals/">{t.festivals} ›</a>
  </p>
</section>

<section class="wrap">
  <h2 class="section-title">Real before and after results</h2>
  <div class="showcase">
    {showcase.map((p) => (
      <a class="sc" href={p.url}>
        <span class="pair">
          <span><img src={th(p.sample.before)} alt={`Before: ${p.t}`} loading="lazy" width="500" height="625" /><i>Before</i></span>
          <span><img src={th(p.sample.chatgpt)} alt={`After: ${p.t}`} loading="lazy" width="500" height="625" /><i>After</i></span>
        </span>
        <b>{p.t}</b>
      </a>
    ))}
  </div>
</section>

<section class="wrap">
  <h2 class="section-title">{t.browse}</h2>
  <div class="tiles">
    {PAGES.map((c) => (
      <a class="tile" href={colUrl(c, lang)} style={`background:${c.tint};color:#1d1d1f`}>
        {colImg(c.id) ? <img class="thumb" src={colImg(c.id)} alt={`${cName(c, lang)} – AI photo editing result`} loading="lazy" width="200" height="200" /> : <span class="emoji" aria-hidden="true">{c.emoji}</span>}
        <span>
          <span class="name" style="display:block">{cName(c, lang)}</span>
          <span class="count" style="color:#48484a">{inCollection(c.id).length} {t.prompts}</span>
        </span>
      </a>
    ))}
  </div>
</section>

<section class="wrap">
  <Steps lang={lang} />
</section>

{lang === 'en' && (
  <section class="wrap about-home">
    <h2 class="section-title">Free photo editing prompts that keep your real face</h2>
    <p>PhotoEditingPrompt.com is a free library of copy-and-paste prompts for ChatGPT and Google Gemini. Pick a style (couple, girls, boys, family, cars, festivals, game art or movie-star looks), tap <b>Copy prompt</b>, upload your own photo in ChatGPT or Gemini and paste. Every prompt starts with a face-lock instruction so the result still looks like you, and you can change the outfit, colour and background before you copy.</p>
    <h2 class="section-title">Questions and answers</h2>
    <div class="faq">
      {HOME_FAQ.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </section>
)}
