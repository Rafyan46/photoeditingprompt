---
import { T, SITE, type Lang } from '../data/site';
import { label, shortOpt, type Prompt } from '../lib/prompts';
import { thumbSize } from '../lib/thumb-size';
interface Props { p: Prompt; lang?: Lang; n?: number; linkTitle?: boolean; heading?: 'h2' | 'h3' }
const { p, lang = 'en', n, linkTitle = true, heading: H = 'h2' } = Astro.props;
const t = T[lang];
const after = p.sample.chatgpt ?? p.sample.gemini;
const afterTool = p.sample.chatgpt ? 'ChatGPT' : 'Gemini';
const vars = Object.entries(p.v ?? {});
// Landscape samples (family and group photos) are shown 4:3, so nobody is cropped out of the picture.
const size = await thumbSize(after) ?? await thumbSize(p.sample.before);
const wide = !!size && size.w > size.h;
const [iw, ih] = wide ? [1280, 960] : [1000, 1250];
// On list pages (collections, festivals) use the small thumbnail and lazy-load; the single prompt page keeps the full-size picture.
// The compare slider is shown large, so it uses the full-size picture (the 10 KB thumbnails looked blurry when stretched to about 700 px).
const pic = (u: string) => u;
const lz = linkTitle ? 'lazy' : undefined;
const pinUrl = after ? `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(new URL(p.url, SITE.url).href)}&media=${encodeURIComponent(new URL(after, SITE.url).href)}&description=${encodeURIComponent(p.t + ' – free ChatGPT & Gemini photo editing prompt')}` : '';
---
<section class="prompt-block" id={p.s} data-template={p.template}>
  <div class="head">
    <H class="pt">
      {n && <span class="muted">{n}. </span>}
      {linkTitle ? <a href={p.url}>{p.t}</a> : p.t}
    </H>
    <div class="badges">
      {linkTitle && <span class="badge">{t.worksWith}</span>}
      {p.tested && <span class="badge ok">✓ {t.tested}</span>}
    </div>
  </div>

  {p.sample.before && after && (
    <div class:list={['ba', wide && 'wide']}>
      <img src={pic(p.sample.before)} alt={`${p.t} – original photo before the AI edit`} width={iw} height={ih} decoding="async" loading={lz} fetchpriority={linkTitle ? undefined : 'high'} />
      <img class="after" src={pic(after)} alt={`${p.t} – AI photo editing result from ${afterTool}`} width={iw} height={ih} decoding="async" loading={lz} fetchpriority={linkTitle ? undefined : 'high'} />
      <span class="bar"><i class="knob" aria-hidden="true">◀ ▶</i></span>
      <span class="hint" aria-hidden="true">👆 Drag to compare</span>
      <span class="lab l">{t.before}</span>
      <span class="lab r">{t.after} · {afterTool}</span>
      <input type="range" min="0" max="100" value="50" aria-label={t.sample} />
    </div>
  )}
  {!p.sample.before && after && (
    <div class:list={['ba', wide && 'wide']}><img src={pic(after)} alt={`${p.t} – AI photo editing result from ${afterTool}`} width={iw} height={ih} decoding="async" loading={linkTitle ? 'lazy' : 'eager'} fetchpriority={linkTitle ? undefined : 'high'} /></div>
  )}

  {vars.length > 0 && (
    <details class="custom">
      <summary><span class="lbl">⚙ {t.customise}</span><span class="hint">{vars.map(([k]) => label(k)).join(' · ')}</span></summary>
      <div class="customiser">
        {vars.map(([key, options]) => (
          <label>
            {label(key)}
            <select data-key={key}>
              {options.map((o) => <option value={o} title={o}>{shortOpt(o)}</option>)}
            </select>
          </label>
        ))}
      </div>
    </details>
  )}

  {p.tip && <p class="tip">💡 {p.tip}</p>}

  <div class="foot">
    <button class="btn" type="button" data-copy-btn>{t.copy}</button>
    <button class="btn ghost favbtn" type="button" data-fav={p.s} aria-pressed="false" aria-label="Save this prompt">♡</button>
    <a class="btn ghost" href="https://chatgpt.com/" data-open="chatgpt" rel="noopener nofollow">Open in ChatGPT ↗</a>
    <a class="btn ghost" href="https://gemini.google.com/app" data-open="gemini" rel="noopener nofollow">Open in Gemini ↗</a>
    {pinUrl && <a class="btn ghost" href={pinUrl} target="_blank" rel="noopener nofollow" aria-label="Pin this on Pinterest">📌 Pin</a>}
  </div>

  <details class="full-prompt" data-show={t.viewFull} data-hide={t.hideFull}>
    <summary><span class="lbl">{t.viewFull}</span><span class="hint">{t.pasteHint}</span></summary>
    <p class="prompt-text" data-prompt-text>{p.text}</p>
  </details>
</section>
