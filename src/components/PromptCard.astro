---
import { T, type Lang } from '../data/site';
import { cName, type Prompt } from '../lib/prompts';
import cast from '../data/cast.json';
import { thumbSize } from '../lib/thumb-size';
import { existsSync } from 'node:fs';
interface Props { p: Prompt; lang?: Lang; extra?: boolean; eager?: boolean; chunk?: number; showBefore?: boolean }
const { p, lang = 'en', extra = false, eager = false, chunk = 0, showBefore = false } = Astro.props;
const t = T[lang];
const full = p.sample.chatgpt ?? p.sample.gemini;
// Cards load a small thumbnail (made by scripts/make-thumbs.ts); the prompt page keeps the full picture.
const img = full ? full.replace(/\.webp$/, '-thumb.webp') : undefined;
// The photo on the card decides who it is for: the sample was made with the man, woman, couple, family or car cast.
const size = await thumbSize(img);
// Small 'before' photo in the corner (the photo this result was made from), only where its thumbnail exists.
const bt = showBefore && p.sample.before ? p.sample.before.replace(/\.webp$/, '-thumb.webp') : undefined;
const beforeThumb = bt && existsSync(`public${bt}`) ? bt : undefined;
const g = (cast as Record<string, string>)[p.s];
const byCast: Record<string, string> = { man: 'boy', woman: 'girl', couple: 'couple couples prompt couple prompt generator indian couple husband wife romantic love realistic couple wallpaper mirror', family: 'family', car: 'car' };
const aud = (img && byCast[g] ? byCast[g] : p.a === 'any' ? 'girl boy' : p.a) + (p.lock === 'car' || p.c === 'supercars' ? ' car' : '');
const BOOST: Record<string, string> = { 'game-art': 'gta 6 gta vice city game', movies: 'movie film bollywood tollywood kollywood hero star poster', supercars: 'car cars supercar', 'car-poses': 'ai car prompt car driving trending car thar suv', collage: 'trending collage prompt', couple: 'romantic couples ai couple photo husband wife gemini couple prompt trending', girls: 'women woman ladies prompt for women mirror selfie whatsapp dp aesthetic girl', boys: 'men man mens gemini prompt for men ai prompts for men prompt for men photo prompt for men chatgpt men photo', eighties: '80s trend retro vintage 1980s 1980 prompt 80s look prompt 80s vibe retro couple', aesthetic: 'cinematic photography aesthetic prompt stylish viral instagram mirror', cinematic: 'cinematic photo prompt cinematic image prompt film movie still double exposure black and white cinematic prompt', family: 'group friends', birthday: 'birthday party cake candles balloons happy birthday birthday prompt generator birthday poster banner ai birthday photo editing' };
const keywords = `${p.t} ${p.collection.name} ${p.a} ${p.p} ${BOOST[p.c] ?? ''}`.toLowerCase();
---
<article class:list={['card', extra && 'hidden']} data-card={keywords} data-extra={extra ? '1' : '0'} data-chunk={chunk} data-aud={aud} data-img={img ? '1' : '0'} data-slug={p.s}>
  <button class="fav" type="button" data-fav={p.s} aria-pressed="false" aria-label="Save this prompt">♡</button>
  <div class="artwrap">
    <a class="art" href={p.url} style={`background:${p.collection.tint}`} aria-label={p.t}>
      {img ? <img src={img} alt={`${p.t} – example result`} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" width={size?.w ?? 600} height={size?.h ?? 800} /> : <span aria-hidden="true">{p.collection.emoji}</span>}
    </a>
    <span class="tag">{cName(p.collection, lang)}</span>
    {beforeThumb && <span class="beforebox"><img src={beforeThumb} alt={`Original photo before the ${p.t} edit`} loading="lazy" decoding="async" width="120" height="150" /><i>Before</i></span>}
    <div class="open-over">
      <a href="https://chatgpt.com/" target="_blank" rel="noopener nofollow" data-open-card="chatgpt" class="btn gpt" aria-label={`Open ${p.t} in ChatGPT`} title="Open in ChatGPT"><img class="ico" src="/icons/chatgpt.png" width="20" height="20" alt="" /><span>ChatGPT ↗</span></a>
      <a href="https://gemini.google.com/app" target="_blank" rel="noopener nofollow" data-open-card="gemini" class="btn gem" aria-label={`Open ${p.t} in Gemini`} title="Open in Gemini"><img class="ico" src="/icons/gemini.png" width="20" height="20" alt="" /><span>Gemini ↗</span></a>
    </div>
    <button class="btn copy-over" type="button" data-copy-btn >{t.copy}</button>
  </div>
  <div class="body">
    <h3><a href={p.url}>{p.t}</a></h3>
    <p class="snippet">{p.p.replace(/\{(\w+)\}/g, (_, k) => p.v?.[k]?.[0] ?? '')}</p>
  </div>
</article>
