---
import { T, type Lang } from '../data/site';
import { cName, type Prompt } from '../lib/prompts';
interface Props { p: Prompt; lang?: Lang; extra?: boolean }
const { p, lang = 'en', extra = false } = Astro.props;
const t = T[lang];
const img = p.sample.chatgpt ?? p.sample.gemini;
const aud = [p.a === 'any' ? 'girl boy' : p.a, p.lock === 'car' || p.c === 'supercars' ? 'car' : ''].join(' ').trim();
const keywords = `${p.t} ${p.collection.name} ${p.a} ${p.p}`.toLowerCase();
---
<article class:list={['card', extra && 'hidden']} data-card={keywords} data-extra={extra ? '1' : '0'} data-aud={aud} data-slug={p.s}>
  <button class="fav" type="button" data-fav={p.s} aria-pressed="false" aria-label="Save this prompt">♡</button>
  <a class="art" href={p.url} style={`background:${p.collection.tint}`} aria-label={p.t}>
    {img ? <img src={img} alt={`${p.t} – example result`} loading="lazy" width="800" height="600" /> : <span aria-hidden="true">{p.collection.emoji}</span>}
  </a>
  <div class="body">
    <div class="badges">
      <span class="badge">{cName(p.collection, lang)}</span>
      <span class="badge">{t.worksWith}</span>
      {p.tested && <span class="badge ok">✓ {t.tested}</span>}
    </div>
    <h3><a href={p.url}>{p.t}</a></h3>
    <p class="snippet">{p.p.replace(/\{(\w+)\}/g, (_, k) => p.v?.[k]?.[0] ?? '')}</p>
    <div class="row">
      <a class="link" href={p.url} style="font-size:14px">{t.open} ›</a>
      <button class="btn" type="button" data-copy-btn data-copy={p.text}>{t.copy}</button>
    </div>
  </div>
</article>
