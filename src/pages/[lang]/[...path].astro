---
import Base from '../../layouts/Base.astro';
import CollectionBody from '../../components/CollectionBody.astro';
import { OTHER_LANGS, type Lang } from '../../data/site';
import { PAGES, cH1, cIntro, metaDesc, inCollection } from '../../lib/prompts';
import { itemList } from '../../lib/schema';
export function getStaticPaths() {
  return OTHER_LANGS.flatMap((l) => PAGES.map((c) => ({ params: { lang: l.code, path: c.path }, props: { c } })));
}
const { c } = Astro.props;
const lang = Astro.params.lang as Lang;
// Hindi and Marathi share the same heading pattern, so give each its own "for" wording to keep page titles unique.
const FOR: Partial<Record<Lang, string>> = { hi: 'ChatGPT, Gemini के लिए', mr: 'ChatGPT, Gemini साठी' };
---
<Base lang={lang} title={`${cH1(c, lang)} | ${FOR[lang] ?? 'ChatGPT, Gemini'}`} desc={metaDesc(cIntro(c, lang))} i18n={`${c.path}/`} noindex noAlternates schema={[itemList(cH1(c, lang), inCollection(c.id))]}>
  <CollectionBody c={c} lang={lang} />
</Base>
