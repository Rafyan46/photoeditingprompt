---
import Base from '../../layouts/Base.astro';
import PromptBlock from '../../components/PromptBlock.astro';
import PromptCard from '../../components/PromptCard.astro';
import Steps from '../../components/Steps.astro';
import { ALL, inCollection, colUrl, metaDesc, label } from '../../lib/prompts';
import { breadcrumbs, article } from '../../lib/schema';
import { whatItDoes, metaFor } from '../../lib/prompt-copy';
import { GUIDE } from '../../lib/guide';
export function getStaticPaths() {
  return ALL.map((p) => ({ params: { slug: p.s }, props: { p } }));
}
const { p } = Astro.props;
const c = p.collection;
const others = inCollection(c.id).filter((o) => o.s !== p.s);
const hasImg = (o: typeof p) => Boolean(o.sample.chatgpt ?? o.sample.gemini);
// Show prompts with a result image first, so the cards never look empty.
const sameColl = [...others.filter(hasImg), ...others.filter((o) => !hasImg(o))];
// Small collections (the festival hubs have only two prompts) are topped up with the closest prompts elsewhere:
// same kind of page (festival or not) and same audience first, so there are always 3 or 4 related prompts.
const elsewhere = ALL.filter((o) => o.c !== p.c && o.collection.festival === c.festival)
  .sort((x, y) => Number(y.a === p.a) - Number(x.a === p.a) || Number(hasImg(y)) - Number(hasImg(x)));
const related = [...sameColl, ...elsewhere].slice(0, 4);
// Two prompts share a name (in different collections), so add the collection to keep every title unique.
const sameName = ALL.filter((o) => o.t === p.t).length > 1;
const base = sameName ? `${p.t} (${c.name})` : p.t;
// Keep titles under about 62 characters so Google does not cut them off in search results.
const title = [` Prompt – Free for ChatGPT & Gemini`, ` Prompt for ChatGPT & Gemini`, ` Prompt for ChatGPT`, ` Prompt (Free)`].map((x) => base + x).find((x) => x.length <= 62) ?? `${base} Prompt`;
// Scene text of this prompt with its first options filled in: this is what makes each page's text unique.
const scene = p.p.replace(/\{(\w+)\}/g, (_: string, k: string) => p.v?.[k]?.[0] ?? '').replace(/\s+/g, ' ').trim();
const desc = metaFor(p, 155);
const about = whatItDoes(p);
const shareImage = p.sample.chatgpt ?? p.sample.gemini;
const options = Object.keys(p.v ?? {});
const g = GUIDE[p.lock];
---
<Base
  title={title}
  desc={desc}
  ogType="article"
  image={shareImage}
  schema={[breadcrumbs([{ name: 'Home', url: '/' }, { name: c.name, url: colUrl(c) }, { name: p.t, url: p.url }]), article(p, desc)]}
>
  <div class="narrow">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href={colUrl(c)}>{c.h1}</a> › {p.t}
    </nav>
    <header style="padding:28px 0 20px">
      <p class="eyebrow">{c.name} prompt · Works with ChatGPT &amp; Gemini</p>
      <h1 class="page-title" style="font-size:clamp(28px,4.4vw,42px);margin-top:8px">{p.t} Prompt</h1>
      <p class="lead" style="margin-left:0;max-width:none">
        Upload your photo to ChatGPT or Gemini and paste this prompt.
        {options.length > 0 && ` You can change the ${options.join(' and ')} below before you copy.`}
      </p>
    </header>

    <PromptBlock p={p} linkTitle={false} />

    <details class="prose more-info" style="margin:20px 0"><summary style="cursor:pointer;font-weight:600">More about this prompt: what you get, which photo to upload, fixes</summary>
      <p style="line-height:1.7">{about}</p>
      <h2>What you get with {p.t}</h2>
      <p>{scene}</p>
      {options.length > 0 && (
        <ul>
          {Object.entries(p.v ?? {}).map(([key, opts]) => <li><strong>{label(key)}:</strong> {(opts as string[]).join(', ')}</li>)}
        </ul>
      )}
      <p>The first block of the prompt is the identity lock: it tells the AI to treat your uploaded photo as the only reference for who is in the picture, so your face stays yours.</p>
      <h2>Which photo to upload</h2>
      <ul>{g.upload.map((u) => <li>{u}</li>)}</ul>
      <h2>If the result goes wrong</h2>
      <div class="fixes">
        {g.fixes.map((f) => (<div class="fix"><strong>{f.problem}</strong><p>{f.fix}</p></div>))}
      </div>
    </details>

    <Steps />

    {related.length > 0 && (
      <section>
        <h2 class="section-title">Related prompts</h2>
        <div class="grid">
          {related.map((r) => <PromptCard p={r} />)}
        </div>
        <p style="margin-top:20px"><a class="link" href={colUrl(c)}>All prompts in this category: {c.h1} ›</a></p>
      </section>
    )}
  </div>
</Base>
