---
import Base from '../layouts/Base.astro';
import HomeBody from '../components/HomeBody.astro';
import { ALL } from '../lib/prompts';
import { itemList } from '../lib/schema';
import { HOME_FAQ } from '../data/site';
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: HOME_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base
  title={`Photo Editing Prompts for ChatGPT & Gemini – ${Math.floor(ALL.length / 10) * 10}+ Free (2027)`}
  desc={`${Math.floor(ALL.length / 10) * 10}+ free photo editing prompts for ChatGPT and Gemini: copy, paste and keep your real face. Copy-paste AI photo prompts: couple, girls, boys, family, wedding, birthday, cinematic, 80s trend, festivals.`}
  i18n=""
  schema={[itemList('Newest photo editing prompts', ALL.filter((p) => !/^(mothers-day|fathers-day|friendship-day)-|underwater-wallpaper|rakhi-photo-collage/.test(p.s)).slice(0, 20)), faqSchema]}
>
  <HomeBody lang="en" />
</Base>
