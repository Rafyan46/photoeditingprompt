---
import Base from '../../layouts/Base.astro';
import PromptBlock from '../../components/PromptBlock.astro';
import { PAGES, HUB, colUrl, inCollection } from '../../lib/prompts';
import { breadcrumbs, itemList, faqPage } from '../../lib/schema';
const faqs = [
  { q: 'Is there a Raksha Bandhan prompt for brother and sister photos?', a: 'Yes. The Raksha Bandhan section below has rakhi-tying and laughing-siblings prompts for ChatGPT and Gemini. Upload one photo of both of you, and keep the line that locks both faces. Also searched as a rakshabandhan prompt or a Rakhi photo editing prompt.' },
  { q: 'Where is the Ganesh Chaturthi prompt?', a: 'See the Ganesh Chaturthi section below: a home Ganpati welcome and a visarjan procession. Each is a free copy-and-paste Ganesh Chaturthi prompt for ChatGPT and Gemini that keeps your own face.' },
  { q: 'Is there an Independence Day or 15 August photo edit prompt?', a: 'Yes. The Independence Day section has tricolour portraits for 15 August, and the Republic Day page has the flag portrait and flag hoisting salute. They draw the flag respectfully and keep your face.' },
  { q: 'Which prompts make Diwali AI images?', a: 'The Diwali and Chhath section below has a diya and rangoli portrait and the Chhath river ghat at sunrise. Paste one with your photo into ChatGPT or Gemini to make Diwali AI images of yourself.' },
  { q: 'When are new festival prompts added?', a: 'Three to four weeks before each festival, so you can copy them in time. The nearest festivals have their own page, and the rest grow into one as their date comes closer.' },
];
const own = PAGES.filter((c) => c.festival);
const hubPrompts = HUB.flatMap((c) => inCollection(c.id));
---
<Base
  title="Festival AI Photo Prompts for ChatGPT & Gemini"
  desc="Free festival photo editing prompts for ChatGPT and Gemini: Raksha Bandhan, Ganesh Chaturthi, Independence Day, Diwali, Pongal, Holi, Eid, Onam and more."
  schema={[breadcrumbs([{ name: 'Home', url: '/' }, { name: 'Festivals', url: '/festivals/' }]), itemList('Festival photo prompts', hubPrompts), faqPage({ faqs } as any)]}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a>{' › '}Festivals</nav>
    <header style="padding:28px 0 8px">
      <p class="eyebrow">Festival prompts</p>
      <h1 class="page-title" style="font-size:clamp(32px,5vw,48px);margin-top:8px">Festival Photo Prompts</h1>
      <p class="lead" style="margin-left:0">Photo editing prompts for every major Indian festival. The nearest festivals have their own pages; the rest are below, and each grows into a full page a few weeks before its date.</p>
    </header>

    <h2 class="section-title">Coming up next</h2>
    <div class="tiles">
      {own.map((c) => (
        <a class="tile" href={colUrl(c)} style={`background:${c.tint};color:#1d1d1f`}>
          <span class="emoji" aria-hidden="true">{c.emoji}</span>
          <span>
            <span class="name" style="display:block">{c.name}</span>
            <span class="count" style="color:#48484a">{inCollection(c.id).length} prompts</span>
          </span>
        </a>
      ))}
    </div>

    <h2 class="section-title">All year</h2>
    <div class="tiles">
      {HUB.map((c) => (
        <a class="tile" href={`#${c.id}`} style={`background:${c.tint};color:#1d1d1f;min-height:96px`}>
          <span class="emoji" aria-hidden="true">{c.emoji}</span>
          <span class="name">{c.name}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="narrow">
    {HUB.map((c) => (
      <section class="hub-section" id={c.id}>
        <h2 class="section-title" style="margin-bottom:4px">{c.emoji} {c.name}</h2>
        <p class="when">{c.when}</p>
        <p class="muted" style="margin:8px 0 20px">{c.intro}</p>
        {inCollection(c.id).map((p) => <PromptBlock p={p} heading="h3" />)}
      </section>
    ))}
    <section class="faq">
      <h2 class="section-title">Questions and answers</h2>
      {faqs.map((x) => (<details><summary>{x.q}</summary><p>{x.a}</p></details>))}
    </section>
  </div>
</Base>
