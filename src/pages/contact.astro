---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="Contact PhotoEditingPrompt" desc="Get in touch with PhotoEditingPrompt about a prompt, a correction or a suggestion.">
  <div class="narrow">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › Contact</nav>
    <h1 class="page-title" style="font-size:clamp(30px,5vw,44px);margin:28px 0 20px">Contact</h1>
    <div class="prose">
      <p>Found a prompt that does not work, want to suggest a new one, or have a copyright or privacy question? Email us at <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      <p>Please include the name of the prompt and which tool you used (ChatGPT or Gemini). We read every message, but cannot promise a reply to each one.</p>
    </div>
  </div>
</Base>
