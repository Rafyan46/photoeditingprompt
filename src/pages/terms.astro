---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="Terms of Use | PhotoEditingPrompt" desc="Terms for using the prompts on PhotoEditingPrompt.">
  <div class="narrow">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › Terms of Use</nav>
    <h1 class="page-title" style="font-size:clamp(30px,5vw,44px);margin:28px 0 20px">Terms of Use</h1>
    <div class="prose">
      <p>Last updated: 15 November 2026.</p>
      <h2>Using the prompts</h2>
      <p>You may copy and use the prompts on this site for free, for personal or commercial photo edits. Please do not republish the prompt library itself on another website or app.</p>
      <h2>Use them on photos you have the right to edit</h2>
      <p>Only upload photos of yourself, or of people who have agreed to it. Do not use these prompts to make misleading or harmful images of anyone.</p>
      <h2>No guarantee of results</h2>
      <p>AI tools give different results each time. We cannot promise that a prompt will produce a particular image, and edited photos may not be accepted for official documents.</p>
      <h2>Third-party tools</h2>
      <p>ChatGPT and Gemini are run by other companies and are not affiliated with this site. Your use of them is covered by their own terms.</p>
      <h2>Changes</h2>
      <p>We may update these terms. The date at the top shows the latest version.</p>
    </div>
  </div>
</Base>
