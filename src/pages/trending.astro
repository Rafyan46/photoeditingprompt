---
import Base from '../layouts/Base.astro';
import PromptCard from '../components/PromptCard.astro';
import { ALL, inCollection } from '../lib/prompts';
import { SITE_UPDATED } from '../data/site';
const viral = inCollection('viral');
import { breadcrumbs, itemList, faqPage } from '../lib/schema';
const faqs = [
  { q: 'What is the new trending prompt for Instagram photos?', a: 'The newest looks are listed first on this page. Each one is a free copy-and-paste prompt for ChatGPT or Gemini that keeps your own face. Pick the outfit and setting, copy it, and paste it with your photo.' },
  { q: 'Which Google Gemini trending photo prompts work?', a: 'The prompts here work in Gemini and in ChatGPT. Upload one clear front-facing photo first, then paste the prompt. Use the Open in Gemini button on any prompt.' },
  { q: 'Where can I copy a Gemini AI photo prompt for the trending look?', a: 'Open any prompt on this page, tap Copy prompt, then paste it into Gemini with one clear photo of yourself. Every prompt here is plain text you can copy and paste for free.' },
  { q: 'Where is the Instagram trending prompt to copy and paste?', a: 'It is on this page. The new trending prompt, trending AI photo prompt and trending photo editing prompt for ChatGPT or Gemini are listed newest first. Tap Copy prompt, paste it with your photo, and send.' },
  { q: 'What are the new AI prompts and trending couple prompts this week?', a: 'The newest trending AI photo prompts are at the top of this page, and the viral couple looks are in the Viral list and on the Couple page. Each is a free copy-and-paste prompt for ChatGPT or Gemini.' },
  { q: 'What is the trending prompt on Instagram right now?', a: 'The viral looks at the top of this page are the ones going around Instagram and WhatsApp status this week. Copy one, paste it into ChatGPT or Gemini with a clear photo, and your own face stays in the result.' },
  { q: 'How do I use a trending prompt in ChatGPT?', a: 'Tap Copy prompt, open ChatGPT, upload one clear front-facing photo, paste the prompt and send. Run it again if the first result is not quite right.' },
  { q: 'How often do you add new trending prompts?', a: 'We add new prompts as looks start trending on Instagram, usually every few days. Festival looks are added ahead of each festival.' },
  { q: 'Do I need to pay or watch an ad to copy a prompt?', a: 'No. Every prompt on this site is free to copy, with no coins and no ads before the Copy button.' },
];
---
<Base
  title="New Trending Prompts 2026: AI Photo Prompts (Copy & Paste)"
  desc="New trending prompts 2026: free copy and paste ChatGPT and Gemini photo editing prompts for Instagram, newest first. Couple, 80s and festival looks."
  schema={[breadcrumbs([{ name: 'Home', url: '/' }, { name: 'Trending', url: '/trending/' }]), itemList('Trending photo editing prompts', ALL), faqPage({ faqs } as any)]}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › Trending</nav>
    <header style="padding:28px 0 28px">
      <p class="eyebrow">{ALL.length} prompts · newest first</p>
      <h1 class="page-title" style="font-size:clamp(32px,5vw,48px);margin-top:8px">New Trending Prompts 2026: AI Photo Prompts</h1>
      <p class="lead" style="margin-left:0">The new trending prompt list for Instagram photos, for ChatGPT and Gemini. Every prompt on the site, newest first, free to copy. New ones land here as they are published.</p>
    </header>
    <h2 class="section-title" style="margin-top:8px">🔥 Viral right now</h2>
    <p class="muted" style="margin:-8px 0 20px">The looks people are sharing this week. Updated {SITE_UPDATED}. <a class="link" href="/viral-photo-prompts/">Open the full list ›</a></p>
    <div class="grid">
      {viral.map((p) => <PromptCard p={p} />)}
    </div>
    <h2 class="section-title">All prompts, newest first</h2>
    <div class="grid">
      {ALL.filter((p) => p.c !== 'viral').map((p) => <PromptCard p={p} />)}
    </div>
    <section class="faq">
      <h2 class="section-title">Questions and answers</h2>
      {faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
  </div>
</Base>
